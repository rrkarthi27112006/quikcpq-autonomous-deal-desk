# QuikCPQ Deal Desk Agent — Environment Configuration
# Copy this file to backend/.env and fill in your credentials.

# 1. Persistent Cloud Database (Optional — uses local SQLite audit.db if left blank)
# For cloud deployment (Render/Railway/Neon/Supabase), paste your PostgreSQL URL:
DATABASE_URL=

# 2. Google Gemini API (for live NLP RFP extraction & bespoke proposal drafting)
GEMINI_API_KEY=

# 3. Inbound Email Sync (IMAP) — Automatically pulls client RFP emails from your inbox
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# 4. Outbound Email Delivery (SMTP) — Sends approved quotes & PDFs directly to clients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=QuikCPQ Deal Desk
