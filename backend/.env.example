# QuikCPQ Deal Desk Agent — Environment Configuration
# Copy this file to backend/.env and fill in your credentials to enable live AI & real email.

# 1. Google Gemini API (for live NLP RFP extraction & bespoke proposal drafting)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Inbound Email Sync (IMAP) — Automatically pulls client RFP emails from your inbox
# For Gmail: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# 3. Outbound Email Delivery (SMTP) — Sends approved quotes & PDFs directly to clients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=QuikCPQ Deal Desk
